# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Unit test / coverage reports
.pytest_cache/
.coverage
htmlcov/
coverage/

# Editor/OS specific files
.vscode/
.idea/
.DS_Store
Thumbs.db

# OSCAL-Pages and reference repos
/OSCAL-Pages/
/oscal-reference/

# Node.js
node_modules/
dist/

# Ignore generated user session workspaces, but track default/ (master templates)
reposol/data/workspaces/*
!reposol/data/workspaces/default
!reposol/data/workspaces/.gitkeep
reposol/data/workspaces/default/**/*.json
!reposol/data/workspaces/default/catalogs/712a37be-9685-4c25-99d6-f7a193a36468.json
